# Banco relacional + vetorial
DATABASE_URL=postgresql://bnbo:bnbo@localhost:5432/bnbo

# Cache / fila de jobs assíncronos (Celery)
REDIS_URL=redis://localhost:6379/0

# Modelo de embedding (multilingual-e5-large, 768d)
EMBED_MODEL_NAME=intfloat/multilingual-e5-large

# Transporte do servidor MCP: stdio | sse
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8080
